# Copy this file to ".env" and fill in your free API keys.
# Never commit the real ".env" file to git.

# Get free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# Get free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Optional - only needed if you wire up Supabase for persistent file storage.
# Get from: https://supabase.com -> Project Settings -> API
SUPABASE_URL=
SUPABASE_KEY=
